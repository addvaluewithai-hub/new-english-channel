[{"t0":0.6,"t1":2.6,"text":"أول يوم ليّا في لندن…"},
 {"t0":2.6,"t1":5.75,"text":"وكنت فاكر إن الإنجليزي بتاعي كويس."},
 {"t0":5.75,"t1":7.95,"text":"لحد ما قابلت ميا."},
 {"t0":7.95,"t1":9.85,"text":"MIA: Hi! I'm Mia."},
 {"t0":9.85,"t1":14.2,"text":"YOUSSEF: Hello! I... I Youssef."},
