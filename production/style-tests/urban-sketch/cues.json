[{"t0":0.7,"t1":2.75,"text":"أول يوم ليّا في لندن…"},{"t0":2.75,"t1":5.95,"text":"وكنت فاكر إن الإنجليزي بتاعي كويس."},{"t0":5.95,"t1":8.25,"text":"لحد ما قابلت ميا."},{"t0":8.0,"t1":10.7,"text":"Mia: Hi! I'm Mia."},{"t0":9.9,"t1":15.25,"text":"Youssef: Hello! I... I Youssef."},{"t0":14.8,"t1":17.0,"text":"Mia: Sorry?"}]
